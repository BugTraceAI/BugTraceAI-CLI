{
  "target": "bugstore",
  "source": "BugStore/VULNS.md + authoritative implemented-status from BugStore/src/routes/debug.py (status: planted | not_implemented). Phantoms (not_implemented): V-015 SSRF, V-016 XXE, V-017 File Upload — excluded from recall.",
  "note": "Ground truth for benchmark scoring. `match` = substrings tested against a finding's type (case-insensitive). `loc`/`param` = url/parameter keyword hints used to disambiguate same-type vulns. `detectable` = reasonably findable by a black-box DAST scanner (false for DB/crypto/business-logic-only issues).",
  "vulns": [
    {"id": "V-001", "name": "SQL Injection in Product Search", "tier": 1, "detectable": true,  "match": ["sqli", "sql injection"], "loc": ["/api/products", "/products", "search"], "param": ["search", "q"]},
    {"id": "V-002", "name": "Reflected XSS in Search", "tier": 1, "detectable": true,  "match": ["xss"], "loc": ["search", "/catalog", "/products"], "param": ["search", "q", "searchterm"], "subtype_not": ["stored"]},
    {"id": "V-003", "name": "Stored XSS in Reviews", "tier": 1, "detectable": true,  "match": ["xss"], "loc": ["/api/reviews", "/reviews"], "param": ["text", "comment", "review"], "subtype": ["stored"]},
    {"id": "V-004", "name": "Client-Side Template Injection (Angular)", "tier": 2, "detectable": true,  "match": ["csti", "client-side template", "template injection"], "loc": ["/blog", "legacy_q"], "param": ["legacy_q", "q", "category"]},
    {"id": "V-005", "name": "Open Redirect", "tier": 1, "detectable": true,  "match": ["open redirect", "openredirect", "open_redirect", "redirect"], "loc": ["/api/redirect", "/redirect"], "param": ["url", "redirect", "next"]},
    {"id": "V-006", "name": "Weak Password Hashing (MD5)", "tier": 2, "detectable": false, "match": ["weak password", "md5", "hashing", "cryptographic"], "loc": [], "param": []},
    {"id": "V-007", "name": "Prototype Pollution", "tier": 2, "detectable": true,  "match": ["prototype pollution", "prototype_pollution", "prototype"], "loc": [], "param": ["__proto__", "filter"]},
    {"id": "V-008", "name": "Insecure Cookie Configuration", "tier": 1, "detectable": true,  "match": ["insecure cookie", "cookie configuration", "cookie"], "loc": [], "param": []},
    {"id": "V-009", "name": "IDOR in Orders", "tier": 1, "detectable": true,  "match": ["idor", "insecure direct object", "broken object level"], "loc": ["/api/orders", "/orders"], "param": ["id", "order"]},
    {"id": "V-010", "name": "IDOR in User Profiles", "tier": 1, "detectable": true,  "match": ["idor", "insecure direct object", "broken object level"], "loc": ["/api/user/profile", "/profile", "/user"], "param": ["id", "user"]},
    {"id": "V-011", "name": "Weak JWT & Algorithm Confusion", "tier": 2, "detectable": true,  "match": ["jwt", "algorithm confusion", "weak jwt"], "loc": [], "param": []},
    {"id": "V-012", "name": "Blind SQL Injection in Price Filters", "tier": 2, "detectable": true,  "match": ["sqli", "sql injection", "blind sql"], "loc": ["/api/products", "/products", "price"], "param": ["min_price", "max_price", "price"]},
    {"id": "V-013", "name": "SQL Injection via Cookie (TrackingId)", "tier": 2, "detectable": true,  "match": ["sqli", "sql injection"], "loc": ["cookie", "trackingid"], "param": ["trackingid", "cookie"]},
    {"id": "V-014", "name": "Path Traversal", "tier": 1, "detectable": true,  "match": ["lfi", "path traversal", "local file", "directory traversal", "file inclusion"], "loc": ["/image", "/api/products", "/download"], "param": ["file", "path"]},
    {"id": "V-015", "name": "SSRF via Import URL", "tier": 2, "detectable": true, "implemented": false, "note": "BugStore scanner_importers.py: 'V-015 and V-016 not implemented' — phantom; a finding here is a FALSE POSITIVE", "match": ["ssrf", "server-side request forgery"], "loc": ["import", "/api/import"], "param": ["url", "import_url", "src"]},
    {"id": "V-016", "name": "XXE in XML Import", "tier": 2, "detectable": true, "implemented": false, "note": "BugStore scanner_importers.py: 'V-015 and V-016 not implemented' — /api/admin/import/xml is GET-only (405 on POST). Phantom.", "match": ["xxe", "xml external entity"], "loc": ["import", "xml"], "param": []},
    {"id": "V-017", "name": "Unrestricted File Upload", "tier": 1, "detectable": true, "implemented": false, "note": "BugStore debug.py marks V-017 status=not_implemented — no upload handler exists (/api/upload is a GET-only stub, 405 on POST; zero multipart/UploadFile in src/). Phantom.", "match": ["file upload", "fileupload", "unrestricted upload", "upload"], "loc": ["upload"], "param": ["file"]},
    {"id": "V-018", "name": "Mass Assignment (Role Escalation)", "tier": 2, "detectable": true,  "match": ["mass assignment", "mass_assignment"], "loc": ["/api/user/profile", "/profile"], "param": ["role"]},
    {"id": "V-019", "name": "Improper Input Validation", "tier": 1, "detectable": false, "match": ["improper input", "input validation"], "loc": ["/api/register", "/api/admin/products"], "param": ["username", "name"]},
    {"id": "V-020", "name": "GraphQL Info Disclosure & IDOR", "tier": 2, "detectable": true,  "match": ["graphql"], "loc": ["/api/graphql", "/graphql"], "param": []},
    {"id": "V-021", "name": "RCE via Health Check", "tier": 3, "detectable": true,  "match": ["rce", "remote code execution", "command injection", "os command"], "loc": ["/api/health", "/health"], "param": ["cmd", "command"]},
    {"id": "V-023", "name": "Price Manipulation (Trusted Client)", "tier": 2, "detectable": false, "match": ["price manipulation", "business logic", "mass assignment"], "loc": ["/api/checkout", "/checkout"], "param": ["total", "price", "amount"]},
    {"id": "V-025", "name": "No Rate Limiting", "tier": 1, "detectable": true,  "match": ["rate limit", "rate_limit", "rate-limit", "missing rate"], "loc": [], "param": []},
    {"id": "V-026", "name": "Insecure Deserialization (Pickle)", "tier": 3, "detectable": true, "match": ["deserialization", "deserialisation", "pickle", "insecure deserialization"], "loc": ["/api/user/preferences", "preferences"], "param": ["user_prefs", "cookie"]},
    {"id": "V-027", "name": "Server-Side Template Injection (SSTI)", "tier": 3, "detectable": true,  "match": ["ssti", "server-side template", "template injection", "csti"], "loc": ["/api/admin/email-preview", "email-preview", "email"], "param": ["body", "subject", "template"]},
    {"id": "V-028", "name": "Broken Access Control (Admin)", "tier": 2, "detectable": true,  "match": ["broken access control", "bac", "access control", "broken function level", "authorization"], "loc": ["/api/admin", "/admin"], "param": []},
    {"id": "V-030", "name": "Vulnerable Components (jQuery/Lodash/Angular)", "tier": 1, "detectable": true,  "match": ["vulnerable component", "outdated", "known vulnerab", "vulnerable js", "vulnerable library", "cve-"], "loc": [], "param": []},
    {"id": "V-031", "name": "TOTP Brute Force (No Rate Limit)", "tier": 2, "detectable": false, "match": ["rate limit", "totp", "brute force", "rate_limit"], "loc": ["/api/secure-portal/login", "secure-portal"], "param": ["totp_code", "code"]},
    {"id": "V-032", "name": "TOTP Secret Disclosure in Login", "tier": 2, "detectable": false, "match": ["totp secret", "secret disclosure", "information disclosure", "info disclosure", "sensitive data"], "loc": ["/api/secure-portal/login", "secure-portal"], "param": []}
  ]
}
