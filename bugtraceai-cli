#!/usr/bin/env bash
# Launch the active checkout from any working directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

CLI_ENVIRONMENTS=(.venv_fresh .venv venv)
if [[ -f .bugtrace-install.env ]]; then
    CLI_ENVIRONMENTS=(.venv .venv_fresh venv)
fi
for CLI_VENV in "${CLI_ENVIRONMENTS[@]}"; do
    if [[ -f "$CLI_VENV/bin/activate" ]]; then
        source "$CLI_VENV/bin/activate"
        break
    fi
done

if ! command -v python3 >/dev/null 2>&1; then
    echo "Python 3 is required. Run ./install.sh to install the CLI environment." >&2
    exit 1
fi

# A bare URL means a complete scan; Python owns all options and cleanup.
if [[ "${1:-}" == http://* || "${1:-}" == https://* ]]; then
    exec python3 -m bugtrace full "$@"
fi
exec python3 -m bugtrace "$@"
